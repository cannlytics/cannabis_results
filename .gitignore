*.temp
*.bak

# === OS Files ===
*.DS_Store
.DS_Store
Thumbs.db
desktop.ini

# === Compiled Python ===
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# === Virtual Environments ===
venv/
.venv/
env/
ENV/

