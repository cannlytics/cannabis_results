.vscode/
.idea/
*.swp
*.swo
*~

# === Caches ===
*.cache
.cache/
cache/
.pytest_cache/
.mypy_cache/

# === Jupyter ===
.ipynb_checkpoints/

# === Logs ===
*.log
logs/

# === GitHub-Specific Exclusions ===
